# Environment for the deploy.tz API app (Python stack). Enter these in the app's
# Environment tab; this file is a reference only.
APP_ROLE=api

# Postgres running in your Docker container (deploy/postgres). postgres:// and
# postgresql:// URLs are accepted; the psycopg driver is selected automatically.
TT_DATABASE_URL=postgresql://timetable:<password>@<postgres-host>:5432/timetable

# The website's public URL (CORS fallback for direct browser calls).
TT_FRONTEND_ORIGIN=https://kairos.deploy.tz

# HTTPS in production: mark session cookies Secure.
TT_SECURE_COOKIES=true

# Never serve unpublished versions publicly.
TT_ALLOW_DRAFT_PREVIEW=false

# Uploaded timetable PDFs (used by the admin review screen). See the storage note in
# docs/17-deployment.md: deploy.tz does not document persistent disks.
TT_STORAGE_DIR=./data/storage

# Uvicorn worker processes.
WEB_CONCURRENCY=2
