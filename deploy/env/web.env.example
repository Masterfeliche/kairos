# Environment for the deploy.tz website app (Node stack). Enter these in the app's
# Environment tab; this file is a reference only.
APP_ROLE=web

# The API app's public URL. Used at BUILD time for the /api proxy (browser requests stay
# same-origin, so login cookies work) — redeploy the web app if it changes.
TT_BACKEND_ORIGIN=https://dit-timetable-api.deploy.tz

# Same URL, used at request time by server-rendered pages.
TT_API_BASE=https://dit-timetable-api.deploy.tz

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
