# Environment for the deploy.tz website app (Node stack). Enter these in the app's
# Environment tab; this file is a reference only.
# Optional on the Node stack (npm marks the build as the website), harmless to set.
APP_ROLE=web

# The API app's public URL. The website forwards /api/* to it (browser requests stay
# same-origin, so login cookies work). Read at runtime; restart the app if it changes.
TT_BACKEND_ORIGIN=https://kairos-api.deploy.tz

# Same URL, used at request time by server-rendered pages.
TT_API_BASE=https://kairos-api.deploy.tz

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
